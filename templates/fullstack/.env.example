# Runtime Mode: development | test | production
NODE_ENV=development

# Application URL & Exact Trusted Origins for CSRF/Auth
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Optional comma-separated additional trusted browser origins (exact scheme + host + port)
TRUSTED_ORIGINS=http://localhost:3000

# Reverse Proxy Trust Mode: none (default, ignores proxy headers) | cloudflare | fly | hops:<N>
TRUST_PROXY=none

# Rate Limit Store Driver: postgres (required default in production) | memory (dev/test default)
RATE_LIMIT_DRIVER=memory
# ALLOW_SINGLE_INSTANCE_MEMORY_RATE_LIMIT=false

# Database Connection
# Option A (Zero-Docker embedded real PostgreSQL via PGlite):
DATABASE_URL=pglite://./.data/pgdata
# Option B (Docker / Managed PostgreSQL):
# DATABASE_URL=postgresql://pusula:pusula_local_only@localhost:5432/pusula_dev

# Isolated Test Database (Vitest / Playwright — MUST NEVER point to dev/prod DATABASE_URL)
TEST_DATABASE_URL=pglite://memory

# Session & Token Signing Secret (MUST be >= 32 random chars; production rejects default/placeholder values)
SESSION_SECRET=replace-with-at-least-32-chars-random-secret-before-running

# SMTP Configuration (Mailpit local defaults; set SMTP_USER + SMTP_PASS + TLS in production)
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_FROM="Atolye Pusula <noreply@atolye-pusula.local>"
# SMTP_USER=
# SMTP_PASS=
# SMTP_SECURE=false
# SMTP_REQUIRE_TLS=true
# ALLOW_PROD_DEFERRED_EMAIL_QUEUE=false

# Optional explicit local outbox path (defaults to .data/mailpit-outbox.json in non-production)
MAIL_OUTBOX_FILE=.data/mailpit-outbox.json
